# =============================================================================
# SecureFL — Multi-Tenant Cloud Security & Federated Learning Configuration
# =============================================================================

# Runtime environment: development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Firebase Managed Cloud Backend (Spark-compatible core + Emulator support)
# -----------------------------------------------------------------------------
# Set FIREBASE_ENABLED=true when connecting a real Firebase project or Emulators.
FIREBASE_ENABLED=false
FIREBASE_USE_EMULATOR=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_APP_CHECK_ENFORCED=false

# Server-only Firebase Admin SDK credentials (NEVER commit to Git or place in frontend/)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Firebase Local Emulator Suite hosts (used when FIREBASE_USE_EMULATOR=true)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# -----------------------------------------------------------------------------
# Local Fallback Database (SQLite dev / PostgreSQL optional)
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./multitenant.db
SQLALCHEMY_ECHO=false

# -----------------------------------------------------------------------------
# Security, JWT & AES-256-GCM Cryptography
# -----------------------------------------------------------------------------
# REQUIRED in production (>= 32 random bytes / hex). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# HKDF Master Key (64 hex chars = 32 bytes) & Salt for per-tenant AES-256-GCM DEK derivation
# Supports either TENANT_MASTER_KEY or MASTER_ENCRYPTION_KEY
TENANT_MASTER_KEY=
MASTER_ENCRYPTION_KEY=
TENANT_HKDF_SALT=securefl-hkdf-v2-salt-change-in-production

# Comma-separated allowed CORS origins (never use * with credentials in production)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000

# Rate Limiting
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_API_PER_MIN=120

# -----------------------------------------------------------------------------
# Flower Federated Learning (Local Python / Docker Compute Tier)
# -----------------------------------------------------------------------------
FL_SERVER_HOST=127.0.0.1
FL_SERVER_PORT=8080
FL_METRICS_PORT=8081
FL_NUM_ROUNDS=5
FL_MIN_CLIENTS=5
FL_STRATEGY=krum
FL_KRUM_F=1
FL_TRIM_BETA=0.1
FL_TLS_ENABLED=false
FL_TLS_CA_CERT=./certs/ca.crt
FL_TLS_SERVER_CERT=./certs/server.crt
FL_TLS_SERVER_KEY=./certs/server.key

# -----------------------------------------------------------------------------
# Differential Privacy (Validated RDP Moments Accountant)
# -----------------------------------------------------------------------------
PRIVACY_EPSILON_BUDGET=10.0
PRIVACY_DELTA=0.00001
DP_NOISE_MULTIPLIER=1.2
MAX_GRADIENT_NORM=1.0

# -----------------------------------------------------------------------------
# Observability (Prometheus / Grafana)
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
