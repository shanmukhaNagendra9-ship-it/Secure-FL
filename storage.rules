rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedActive() {
      return isSignedIn() &&
        request.auth.token.is_verified == true &&
        request.auth.token.is_active != false;
    }

    function isAdmin() {
      return isVerifiedActive() && request.auth.token.role == 'admin';
    }

    function isAnalyst() {
      return isVerifiedActive() && (
        request.auth.token.role == 'analyst' ||
        request.auth.token.role == 'admin'
      );
    }

    function isTenantMember(tenantId) {
      return isVerifiedActive() && request.auth.token.tenant_id == tenantId;
    }

    // Tenant-scoped generated security reports (PDF / CSV, max 10 MB)
    match /tenants/{tenantId}/reports/{fileName} {
      allow read: if isAdmin() || isTenantMember(tenantId);
      allow write: if (isAdmin() || (isAnalyst() && isTenantMember(tenantId)))
        && request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType == 'text/csv'
        );
    }

    // Tenant-scoped AES-256-GCM encrypted log archives ONLY (max 25 MB)
    match /tenants/{tenantId}/archives/{fileName} {
      allow read: if isAdmin() || isTenantMember(tenantId);
      allow write: if (isAdmin() || isTenantMember(tenantId))
        && request.resource != null
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream'
        && fileName.matches('.*\\.enc$');
    }

    // Global FL model metadata / checkpoints (Admin SDK writes only)
    match /models/global/{fileName} {
      allow read: if isVerifiedActive();
      allow write: if false;
    }

    // Default deny-all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
